# Copy to .env (gitignored) and fill in. Never commit real keys.

# ---- Database -------------------------------------------------------------
# Local Homebrew Postgres 16 + pgvector. No Docker required.
# Keep the rag_app@ user: it is NOSUPERUSER NOBYPASSRLS, so row-level security
# applies. Without a user the API connects as your OS user, which is a
# superuser on Homebrew and silently bypasses every RLS policy.
# (scripts/seed.py and scripts/ingest.py strip rag_app@ and connect as owner.)
DATABASE_URL=postgresql://rag_app@localhost:5432/travel_rag

# ---- Providers ------------------------------------------------------------
# Leave BOTH blank to run in degraded mode: ingestion cost ESTIMATION, schema,
# provenance and the UI all work with zero keys. Live ingestion needs both
# (Anthropic contextualises, Gemini embeds); live answering needs both.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Runtime --------------------------------------------------------------
# Which YAML config bundle to load from config/. Recorded against every run.
# Relative paths resolve from the working directory: run commands from the repo root.
CONFIG_DIR=config
APP_ENV=local
# The API always listens on 127.0.0.1:8000 (Makefile, web/vite.config.ts and
# scripts/evaluate.py hard-code it); API_HOST / API_PORT are not read.

# ---- Default tenant (single-user today, multi-tenant schema from day one) --
DEFAULT_TENANT_SLUG=acme
DEFAULT_USER_EMAIL=user@example.com
